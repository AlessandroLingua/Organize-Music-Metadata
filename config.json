{
 "folder": "D:/Music",
 "recent_folders": [
  "D:\\Music"
 ],
 "reorganize": true,
 "online": true,
 "covers": true,
 "filename_pattern": "{titolo}",
 "folder_pattern": "{artista} - {album} ({disco})",
 "rename_folders": true,
 "convert": {
  "format": "mp3",
  "qualities": {
   "mp3": "320"
  },
  "mode": "replace",
  "copy": true,
  "overwrite": true,
  "output_dirs": {}
 },
 "duplicates": {
  "across_albums": true,
  "rule": "smallest"
 },
 "maximized": true,
 "geometry": "1360x940+265+19"
}